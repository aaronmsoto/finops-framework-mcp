{
  "$id": "finops-framework-mcp/relationships",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "confidence": {
        "enum": [
          "strong",
          "moderate",
          "weak"
        ]
      },
      "evidence_quote": {
        "type": "string"
      },
      "evidence_url": {
        "format": "uri",
        "type": "string"
      },
      "from": {
        "type": "string"
      },
      "from_maturity": {
        "enum": [
          "crawl",
          "walk",
          "run"
        ]
      },
      "heuristic": {
        "type": "string"
      },
      "rationale": {
        "type": "string"
      },
      "source": {
        "enum": [
          "official",
          "inferred"
        ]
      },
      "to": {
        "type": "string"
      },
      "to_min_maturity": {
        "enum": [
          "crawl",
          "walk",
          "run"
        ]
      },
      "type": {
        "enum": [
          "prerequisite",
          "informs",
          "related"
        ]
      }
    },
    "required": [
      "from",
      "to",
      "type",
      "source"
    ],
    "type": "object"
  },
  "type": "array"
}
