{
  "$id": "tokenomics-overview-mcp/cache-providers",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "lifetime_notes": {
        "type": "string"
      },
      "minimum_prefix": {
        "type": "string"
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string"
          },
          "license": {
            "const": "CC-BY-4.0"
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "document",
          "section",
          "source_url",
          "license"
        ],
        "type": "object"
      },
      "provider": {
        "type": "string"
      },
      "read_charge": {
        "type": "string"
      },
      "reviewed": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "write_charge": {
        "type": "string"
      }
    },
    "required": [
      "slug",
      "provider",
      "write_charge",
      "read_charge",
      "minimum_prefix",
      "lifetime_notes",
      "reviewed",
      "provenance"
    ],
    "type": "object"
  },
  "type": "array"
}
