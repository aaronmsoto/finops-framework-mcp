{
  "$id": "tokenomics-overview-mcp/stages",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "key_question": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string"
          },
          "license": {
            "const": "CC-BY-4.0"
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "document",
          "section",
          "source_url",
          "license"
        ],
        "type": "object"
      },
      "scope": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      }
    },
    "required": [
      "slug",
      "name",
      "scope",
      "key_question",
      "provenance"
    ],
    "type": "object"
  },
  "type": "array"
}
