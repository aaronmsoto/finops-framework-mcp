{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-starter-repo/.agentic/harness/schemas/tasks.schema.json",
  "title": ".agents/tasks.json",
  "description": "Hash-chained task list, managed exclusively by `agentic tasks`. Only `tasks complete` (which runs fast gates first) extends the chain; `tasks validate`, `verify`, and CI recompute it, so hand-editing a status is detectable.",
  "type": "object",
  "required": ["version", "chainHead", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "chainHead": {
      "type": "string",
      "description": "sha256 hash of the most recently completed chain entry, or \"genesis\" when no task has been completed."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "acceptance", "status", "evidence", "hash"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-\\d{3,}$",
            "description": "Assigned by `tasks add`, monotonic (T-001, T-002, ...)."
          },
          "title": { "type": "string", "minLength": 1 },
          "spec": { "type": "string", "description": "Optional path to the spec file (e.g. .agents/specs/foo.md)." },
          "acceptance": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Acceptance criteria — required and non-empty."
          },
          "status": { "enum": ["pending", "in_progress", "done", "blocked"] },
          "evidence": {
            "description": "Null until completed. Written by `tasks complete` after fast gates pass.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["gates", "summary", "commit", "verifiedBy", "completedAt"],
                "additionalProperties": false,
                "properties": {
                  "gates": { "const": "pass" },
                  "summary": { "type": "string", "minLength": 1 },
                  "commit": { "type": "string", "description": "HEAD sha at completion time (\"unknown\" outside a git repo)." },
                  "verifiedBy": { "enum": ["gates", "reviewer", "human"] },
                  "completedAt": { "type": "string", "format": "date-time" }
                }
              }
            ]
          },
          "hash": {
            "description": "Null until completed; then sha256(prevHash + id + canonical-JSON(evidence)) with recursively sorted keys.",
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
          }
        }
      }
    }
  }
}
