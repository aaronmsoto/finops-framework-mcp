{
  "name": "finops-framework-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the FinOps Framework (finops.org) to AI agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "finops-framework-mcp": "dist/servers/framework/main.js"
  },
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "agentic": "node .agentic/harness/dist/cli.js",
    "gates": "node .agentic/harness/dist/cli.js gates",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "refresh": "npm run build && node dist/crawlers/framework/cli.js refresh",
    "server": "npm run build && node dist/servers/framework/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "domhandler": "^6.0.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  }
}
