{
  "name": "finops-framework-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing the official FinOps Framework (finops.org/framework) to AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "finops",
    "cloud-cost",
    "finops-framework"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronmsoto/finops-framework-mcp.git"
  },
  "mcpName": "io.github.aaronmsoto/finops-framework-mcp",
  "bin": {
    "finops-framework-mcp": "dist/servers/framework/main.js"
  },
  "files": [
    "dist/index.js",
    "dist/servers/framework",
    "dist/crawlers/framework",
    "dist/shared",
    "data/framework",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "agentic": "node .agentic/harness/dist/cli.js",
    "gates": "node .agentic/harness/dist/cli.js gates",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "refresh": "npm run build && node dist/crawlers/framework/cli.js refresh",
    "server": "npm run build && node dist/servers/framework/main.js",
    "bundle:worker": "npm run build && node scripts/bundle-worker-data.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  }
}
